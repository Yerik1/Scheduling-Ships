# ─────────────────────────────────────────────────────────────
#  Makefile — Schedulers tests
#
#  Usage (from main/):
#    make -f schedulers/Makefile.test        # compile and run
#    make -f schedulers/Makefile.test build  # only compile
#    make -f schedulers/Makefile.test run    # only run
#    make -f schedulers/Makefile.test clean  # clean
# ─────────────────────────────────────────────────────────────

CC      = gcc
CFLAGS  = -Wall -Wextra -std=c99
 
# Include directories
INCLUDES = -I./common -I./ships -I./schedulers
 
# Sources
SRCS =  schedulers/TestSchedulers.c \
        schedulers/Scheduler.c \
        ships/ship.c \
        ships/ship_factory.c
 
# Executable output
BIN_DIR = bin
TARGET  = $(BIN_DIR)/test_schedulers
 
.PHONY: all build run clean
 
all: build run
 
build: $(TARGET)
 
$(TARGET): $(SRCS)
	@mkdir -p $(BIN_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) $(SRCS) -o $(TARGET)
 
run: $(TARGET)
	@./$(TARGET)
 
clean:
	@rm -f $(TARGET)
